<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- USB host is required: without it there is nothing for the polyfills to talk to. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.TrustedConfigurator">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Lets the system offer "use this app by default" for the flight
                controllers and DFU bootloaders below. That default is what keeps
                a permission dialog from appearing mid-flash when a board drops
                off the bus and comes back in DFU mode as a brand new device.
            -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <activity
            android:name=".SitesActivity"
            android:exported="false"
            android:label="@string/sites_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false"
            android:label="@string/diagnostics_title"
            android:parentActivityName=".MainActivity" />

    </application>

</manifest>
