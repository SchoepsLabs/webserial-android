<?xml version="1.0" encoding="utf-8"?>
<!--
    The foreground carries the mark inside the central 72dp safe zone and is
    flattened onto the same colour as the background, so no launcher mask —
    circle, squircle or rounded square — can reveal a seam or clip the trident.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
