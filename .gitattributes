# Normalise to LF in the repo; check out native. Without this a Windows clone
# commits CRLF and every file looks rewritten to a Linux contributor.
* text=auto eol=lf

# gradlew must keep LF or it will not run on macOS/Linux.
gradlew text eol=lf
gradlew.bat text eol=crlf

*.png binary
*.jar binary
*.apk binary
*.keystore binary
